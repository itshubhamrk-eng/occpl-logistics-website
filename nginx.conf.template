# OCCPL Logistics website. Static files, plus /api/v1/track/ forwarded to the courier backend so the browser
# calls the same domain (no CORS change needed). COURIER_API is set when the container starts,
# e.g. COURIER_API=https://courier.dev.occplsoftech.com
# Old-system lookups per visitor. The visitor's address comes from the proxy in front (Docker network only).
limit_req_zone $binary_remote_addr zone=oldtrack:1m rate=20r/m;
limit_req_zone $binary_remote_addr zone=rates:1m rate=20r/m;

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    absolute_redirect off;

    set_real_ip_from 172.16.0.0/12;
    real_ip_header X-Forwarded-For;

    gzip on;
    gzip_types text/css application/javascript image/svg+xml application/json;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "camera=(self), microphone=(), geolocation=()" always;

    # Public tracking only: GET /track/{number}, POST /track/{number}/verify and /tickets. Nothing else is forwarded.
    location /api/v1/track/ {
        proxy_pass ${COURIER_API}/api/v1/track/;
        proxy_ssl_server_name on;
        proxy_set_header Host ${COURIER_API_HOST};
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_hide_header Set-Cookie;
        client_max_body_size 16k;
    }

    # Public rate calculator (POST only).
    location = /api/v1/public/rates {
        limit_except POST { deny all; }
        limit_req zone=rates burst=10 nodelay;
        limit_req_status 429;
        proxy_pass ${COURIER_API}/api/v1/public/rates;
        proxy_ssl_server_name on;
        proxy_set_header Host ${COURIER_API_HOST};
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_hide_header Set-Cookie;
        client_max_body_size 4k;
    }

    # Shipments of the old system (GET, one AWB). Its address is resolved per request, so the site starts without it.
    location ^~ /api/old-track/ {
        limit_except GET { deny all; }
        limit_req zone=oldtrack burst=10 nodelay;
        limit_req_status 429;
        resolver 127.0.0.11 valid=60s ipv6=off;
        set $old_host occplserver.azurewebsites.net;
        rewrite "^/api/old-track/([A-Za-z0-9_-]{4,30})$" /track-status?awb_no=$1 break;
        if ($uri != /track-status) { return 404; }
        proxy_pass https://$old_host;
        proxy_ssl_server_name on;
        proxy_ssl_name $old_host;
        proxy_ssl_verify on;
        proxy_ssl_verify_depth 3;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_set_header Host $old_host;
        proxy_set_header Origin "";
        proxy_set_header Cookie "";
        proxy_read_timeout 30s;
        proxy_hide_header Set-Cookie;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
    }

    location /assets/ { expires 30d; add_header Cache-Control "public"; }

    # Old WordPress addresses, so existing links and search results keep working.
    location = /about-us/ { return 301 /about/; }
    location = /contact-us/ { return 301 /contact/; }
    location = /track-your-order/ { return 301 /track/; }
    location = /job-openings/ { return 301 /careers/; }
    location = /branch-locator/ { return 301 /branches/; }
    # index.html is excluded: nginx resolves /services/ to it internally, and redirecting it would loop.
    location ~ ^/services/(?!index\.html$).+ { return 301 /services/; }
    location ~ ^/(rate-calculator|pincode-locator|volumetric-weight-calculator|conversion-factors|world-clock|support)/?$ { return 301 /customer-tools/; }
    location ~ ^/(gallery|news-events|blogs)(/.*)?$ { return 301 /; }

    location / { try_files $uri $uri/ =404; }
    error_page 404 /404.html;
}
